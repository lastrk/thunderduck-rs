
# Claude Code authentication (auto-generated, keep secret)
.devcontainer/.claude-auth-token
.devcontainer/.claude-base-url
.devcontainer/.claude-custom-headers

# GitHub auth token forwarded from host (auto-generated, keep secret)
.devcontainer/.github-token
.devcontainer/.gh-auth-token
.reference/

# Rust
/target/
**/*.rs.bk
Cargo.lock

# Per-worktree test environment: remembered server ports (see
# tests/integration/utils/test_env.py) and per-worktree DuckDB extension dir.
/.thunderduck-test-env.json
/.duckdb-ext/

# Python
__pycache__/
*.pyc
.venv/
venv/
tests/integration/logs/
tests/integration/tpch_sf001/
tests/integration/tpcds_sf001/
tests/integration/.env

# DuckDB extension binaries (downloaded by build.rs on every fresh build)
extensions/

# Cross-repo Delta dev loop: local checkouts of our forks of duckdb-delta and
# delta-kernel-rs, materialized + built by scripts/dev/delta-dev-setup.sh.
# See docs/context/delta-cross-repo-dev-loop.md.
/.delta-kernel-rs/
/.duckdb-delta/
# Userspace gcc toolchain (micromamba + conda-forge) for building the extension
# on this gcc-11 devcontainer; bootstrapped by scripts/dev/delta-toolchain-setup.sh.
/.delta-toolchain/

# Vendored Apache Spark reference install (downloaded by setup-differential-testing.sh)
.spark/

# Downloaded build tools
.tools/

# Local build-acceleration cache (mold/sccache binaries, shared sccache cache,
# frozen libduckdb.a). Lives at the main checkout root; see scripts/dev/.
/.build-cache/

# Build-profiling run artifacts (machine/run-specific); harness + FINDINGS kept.
tasks/build-profiling/results/

# Playground runtime state and data
playground/__marimo__/
playground/data/
playground/logs/

# macOS Finder metadata
.DS_Store

# Claude Code local artifacts
.agent-output/
.claude/worktrees/

# codegraph index (per-machine, managed by /agentic-dev:setup)
.codegraph/
