# name: test/sql/decimal_state_alignment.test
# description: DECIMAL aggregate states must stay correct when DuckDB places them at a non-16-byte-aligned offset
# group: [sql]

require thdck_spark_funcs

# ============================================================================
# Why this file exists
#
# DuckDB stores aggregate states inline in its row layout and aligns their
# offsets with AlignValue<T, val=8> — 8 bytes ONLY (see
# duckdb/src/common/types/row/tuple_data_layout.cpp and
# duckdb/src/include/duckdb/common/helper.hpp). A state holding a raw `__int128`
# needs 16, so it lands misaligned in practice: instrumenting Operation() on a
# build of this extension showed the state at `addr % 16 == 8` both for the
# UNION ALL CTE below AND for a plain GROUP BY over DECIMAL.
#
# spark_sum / spark_avg / spark_try_sum therefore store `hugeint_t` and convert
# to `__int128` only for stack-local arithmetic. The compile-time guard is
# SPARK_ASSERT_STATE_ALIGNMENT in src/include/spark_aggregates.hpp — that is what
# actually prevents a regression, because the runtime symptom is
# optimizer- and ISA-dependent (aarch64 LDP/STP and x86 movdqu tolerate 8-byte
# alignment, so a correct-looking result here does NOT prove the state is
# aligned). These queries pin the observable results; the static_assert pins the
# layout.
# ============================================================================

# ---------------------------------------------------------------------------
# GROUP BY + UNION ALL in a CTE — the shape that triggers
# CompressedMaterialization, from the original upstream bug report.
# ---------------------------------------------------------------------------
query III
WITH u AS (SELECT * FROM (VALUES (1, 1.25::DECIMAL(9,2))) t(k,v)
           UNION ALL
           SELECT * FROM (VALUES (1, 2.50::DECIMAL(9,2))) t(k,v))
SELECT k, spark_sum(v), spark_avg(v) FROM u GROUP BY k;
----
1	3.75	1.875000

# spark_try_sum on the same shape. This state (SparkTrySumDecimalState) is the
# one the original upstream fix missed; before it was converted to hugeint_t it
# passed `&state.value` — a misaligned `__int128*` — into
# __builtin_add_overflow.
query II
WITH u AS (SELECT * FROM (VALUES (1, 1.25::DECIMAL(9,2))) t(k,v)
           UNION ALL
           SELECT * FROM (VALUES (1, 2.50::DECIMAL(9,2))) t(k,v))
SELECT k, spark_try_sum(v) FROM u GROUP BY k;
----
1	3.75

# ---------------------------------------------------------------------------
# Plain GROUP BY over DECIMAL — also misaligns (broader than the original
# report, which only described the UNION ALL / CompressedMaterialization path).
# Several groups, so several states at different row offsets.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE align_t (k INTEGER, v DECIMAL(9,2));

statement ok
INSERT INTO align_t VALUES
  (1, 1.25), (1, 2.50), (1, 0.25),
  (2, 10.00), (2, -3.50),
  (3, -1.75), (3, -1.75),
  (4, 0.01);

query IIII
SELECT k, spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM align_t GROUP BY k ORDER BY k;
----
1	4.00	1.333333	4.00
2	6.50	3.250000	6.50
3	-3.50	-1.750000	-3.50
4	0.01	0.010000	0.01

# ---------------------------------------------------------------------------
# Negative accumulators specifically: these are the values whose hugeint_t
# `upper` half is negative, i.e. the ones that went through the signed-shift UB
# in HugeintToInt128 (left-shifting a negative int64_t by 64).
# ---------------------------------------------------------------------------
query III
SELECT spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM (VALUES (-5.00::DECIMAL(9,2)),(-7.50::DECIMAL(9,2)),(2.25::DECIMAL(9,2))) t(v);
----
-10.25	-3.416667	-10.25

# Full-width DECIMAL(38,0), negative, exercising the high half of the 128-bit
# accumulator.
query I
SELECT spark_sum(v) FROM (VALUES
  ((-99999999999999999999999999999999999999)::DECIMAL(38,0)),
  (1::DECIMAL(38,0))) t(v);
----
-99999999999999999999999999999999999998

# ---------------------------------------------------------------------------
# Windowed DECIMAL aggregates — a different state-allocation path from the
# grouped one, and the path the Rust host's spark_avg_decimal_probe pins.
# ---------------------------------------------------------------------------
query IIII
SELECT k, spark_sum(v) OVER (PARTITION BY k), spark_avg(v) OVER (PARTITION BY k),
       spark_try_sum(v) OVER (PARTITION BY k)
FROM align_t WHERE k = 1 ORDER BY v;
----
1	4.00	1.333333	4.00
1	4.00	1.333333	4.00
1	4.00	1.333333	4.00

# ---------------------------------------------------------------------------
# spark_try_sum still returns NULL on overflow — the hugeint_t conversion must
# not have broken overflow tracking. Both paths are covered:
#
#   1. __builtin_add_overflow on the 128-bit accumulator: 2 * (10^38 - 1)
#      ~= 2.0e38 exceeds INT128_MAX (~1.70e38), so the add itself overflows.
#   2. the Abs128(value) >= 10^result_precision limit check in Finalize: the sum
#      fits in __int128 but exceeds the result precision.
# ---------------------------------------------------------------------------
query I
SELECT spark_try_sum(v) FROM (VALUES
  ((99999999999999999999999999999999999999)::DECIMAL(38,0)),
  ((99999999999999999999999999999999999999)::DECIMAL(38,0))) t(v);
----
NULL

# Sum = 1.6e38: fits in __int128 (max ~1.70e38) but exceeds 10^38, so this
# exercises the Finalize limit branch rather than the add-overflow branch.
query I
SELECT spark_try_sum(v) FROM (VALUES
  ((80000000000000000000000000000000000000)::DECIMAL(38,0)),
  ((80000000000000000000000000000000000000)::DECIMAL(38,0))) t(v);
----
NULL

# NULL handling is unchanged by the state rewrite: NULLs are skipped, and an
# all-NULL input yields NULL rather than 0.
query III
SELECT spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM (VALUES (1.25::DECIMAL(9,2)),(NULL),(2.50::DECIMAL(9,2))) t(v);
----
3.75	1.875000	3.75

query III
SELECT spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM (VALUES (NULL::DECIMAL(9,2)),(NULL)) t(v);
----
NULL	NULL	NULL
