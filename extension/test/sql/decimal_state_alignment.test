# name: test/sql/decimal_state_alignment.test
# description: DECIMAL aggregate states must stay correct when DuckDB places them at a non-16-byte-aligned offset
# group: [sql]

require thdck_spark_funcs

# DuckDB places aggregate states at 8-byte offsets, so raw __int128 members
# would be over-aligned. These grouped, UNION, and window shapes exercise
# distinct state allocation/merge paths; SPARK_ASSERT_STATE_LAYOUT is the guard.
# Results alone cannot prove that an over-aligned state is safe.


query III
WITH u AS (SELECT * FROM (VALUES (1, 1.25::DECIMAL(9,2))) t(k,v)
           UNION ALL
           SELECT * FROM (VALUES (1, 2.50::DECIMAL(9,2))) t(k,v))
SELECT k, spark_sum(v), spark_avg(v) FROM u GROUP BY k;
----
1	3.75	1.875000

query II
WITH u AS (SELECT * FROM (VALUES (1, 1.25::DECIMAL(9,2))) t(k,v)
           UNION ALL
           SELECT * FROM (VALUES (1, 2.50::DECIMAL(9,2))) t(k,v))
SELECT k, spark_try_sum(v) FROM u GROUP BY k;
----
1	3.75

statement ok
CREATE TABLE align_t (k INTEGER, v DECIMAL(9,2));

statement ok
INSERT INTO align_t VALUES
  (1, 1.25), (1, 2.50), (1, 0.25),
  (2, 10.00), (2, -3.50),
  (3, -1.75), (3, -1.75),
  (4, 0.01);

query IIII
SELECT k, spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM align_t GROUP BY k ORDER BY k;
----
1	4.00	1.333333	4.00
2	6.50	3.250000	6.50
3	-3.50	-1.750000	-3.50
4	0.01	0.010000	0.01

query III
SELECT spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM (VALUES (-5.00::DECIMAL(9,2)),(-7.50::DECIMAL(9,2)),(2.25::DECIMAL(9,2))) t(v);
----
-10.25	-3.416667	-10.25

query I
SELECT spark_sum(v) FROM (VALUES
  ((-99999999999999999999999999999999999999)::DECIMAL(38,0)),
  (1::DECIMAL(38,0))) t(v);
----
-99999999999999999999999999999999999998

query IIII
SELECT k, spark_sum(v) OVER (PARTITION BY k), spark_avg(v) OVER (PARTITION BY k),
       spark_try_sum(v) OVER (PARTITION BY k)
FROM align_t WHERE k = 1 ORDER BY v;
----
1	4.00	1.333333	4.00
1	4.00	1.333333	4.00
1	4.00	1.333333	4.00

query I
SELECT spark_try_sum(v) FROM (VALUES
  ((99999999999999999999999999999999999999)::DECIMAL(38,0)),
  ((99999999999999999999999999999999999999)::DECIMAL(38,0))) t(v);
----
NULL

# The first case overflows __int128 during accumulation; the next fits there
# but exceeds the DECIMAL(38,0) precision bound during Finalize.
query I
SELECT spark_try_sum(v) FROM (VALUES
  ((80000000000000000000000000000000000000)::DECIMAL(38,0)),
  ((80000000000000000000000000000000000000)::DECIMAL(38,0))) t(v);
----
NULL

# NULL inputs are skipped and an all-NULL aggregate returns NULL.
query III
SELECT spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM (VALUES (1.25::DECIMAL(9,2)),(NULL),(2.50::DECIMAL(9,2))) t(v);
----
3.75	1.875000	3.75

query III
SELECT spark_sum(v), spark_avg(v), spark_try_sum(v)
FROM (VALUES (NULL::DECIMAL(9,2)),(NULL)) t(v);
----
NULL	NULL	NULL
