# name: test/sql/spark_try_avg.test
# description: spark_try_avg parity vs Apache Spark 4.1.1. Corpus: agg2-004.
# group: [sql]

# Oracle: test/spark_oracle/try_funcs.spark.sql (Spark 4.1.1):
#   try_avg(1,2,3 :: bigint)=2.0 (DOUBLE); try_avg(bigint_max,bigint_max)=9.22e18 (DOUBLE,
#   NOT NULL — integer avg uses double accumulation and does not overflow-to-NULL).

require thdck_spark_funcs

# Integer averages use DOUBLE, so large BIGINT inputs stay non-NULL; NULL and
# empty inputs still produce NULL.
query T
SELECT CAST(spark_try_avg(v) AS VARCHAR) FROM (VALUES (1::BIGINT),(2),(3)) t(v);
----
2.0

query T
SELECT CAST(spark_try_avg(v) AS VARCHAR) FROM (VALUES (1::BIGINT),(NULL),(3)) t(v);
----
2.0

query I
SELECT (spark_try_avg(v) > 9e18 AND spark_try_avg(v) < 9.3e18)::INT
FROM (VALUES (9223372036854775807::BIGINT),(9223372036854775807::BIGINT)) t(v);
----
1

query I
SELECT spark_try_avg(v) FROM (VALUES (1::BIGINT)) t(v) WHERE v > 100;
----
NULL

query T
SELECT typeof(spark_try_avg(v)) FROM (VALUES (1::BIGINT)) t(v);
----
DOUBLE
