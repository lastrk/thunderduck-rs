# name: test/sql/spark_try_divide.test
# description: spark_try_divide parity vs Apache Spark 4.1.1. Corpus: math-016.
# group: [sql]

# Oracle: test/spark_oracle/try_funcs.spark.sql (Spark 4.1.1):
#   try_divide(10,2)=5.0 (DOUBLE), try_divide(7,2)=3.5 (DOUBLE),
#   try_divide(1.5,0.5 dec(3,1))=3.000000 DECIMAL(9,6), x/0 -> NULL, NULL op -> NULL.

require thdck_spark_funcs

# Non-DECIMAL numerics use DOUBLE; DECIMAL operands use Spark decimal rules, and
# zero or NULL operands return NULL.
query T
SELECT CAST(spark_try_divide(10, 2) AS VARCHAR);
----
5.0

query T
SELECT CAST(spark_try_divide(7::BIGINT, 2::BIGINT) AS VARCHAR);
----
3.5

query I
SELECT spark_try_divide(10, 0);
----
NULL

query I
SELECT spark_try_divide(10.0::DOUBLE, 0.0::DOUBLE);
----
NULL

query I
SELECT spark_try_divide(NULL::INT, 2);
----
NULL

query I
SELECT spark_try_divide(10, NULL::INT);
----
NULL

query I
SELECT spark_try_divide(1.5::DECIMAL(3,1), 0.5::DECIMAL(3,1));
----
3.000000

query I
SELECT spark_try_divide(1.5::DECIMAL(3,1), 0.0::DECIMAL(3,1));
----
NULL

query T
SELECT typeof(spark_try_divide(10, 2));
----
DOUBLE

query T
SELECT typeof(spark_try_divide(1.5::DECIMAL(3,1), 0.5::DECIMAL(3,1)));
----
DECIMAL(9,6)
