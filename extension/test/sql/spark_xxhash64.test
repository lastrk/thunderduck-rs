# name: test/sql/spark_xxhash64.test
# description: Bit-parity tests for spark_xxhash64 (matches Apache Spark's xxhash64).
# group: [sql]

#              Parity oracle: xxhash64('Spark', array(123), 2) = 5602566077635097486
#              from the official Spark function docs. All other goldens below
#              were captured from this implementation; cross-type invariants
#              (e.g. bool true == int32 1 == tinyint 1) are encoded explicitly.

require thdck_spark_funcs

# -----------------------------------------------------------------------------
# Return type and seed semantics
# -----------------------------------------------------------------------------

query I
SELECT typeof(spark_xxhash64(1::INTEGER));
----
BIGINT

# Zero args returns the initial seed (42L)
query I
SELECT spark_xxhash64();
----
42

# A single NULL leaves the seed unchanged
query I
SELECT spark_xxhash64(NULL::INTEGER);
----
42

# Multiple NULLs of various types — all skipped
query I
SELECT spark_xxhash64(NULL::BIGINT, NULL::VARCHAR, NULL::DOUBLE);
----
42

# NULL columns are SKIPPED, not propagated: the result of hashing (1, NULL, 2)
# must equal the result of hashing (1, 2). This is the Spark semantic; do NOT
# wrap callers in coalesce/IFNULL.
query I
SELECT spark_xxhash64(1::INTEGER, NULL::INTEGER, 2::INTEGER) = spark_xxhash64(1::INTEGER, 2::INTEGER);
----
true

# -----------------------------------------------------------------------------
# Spark documentation golden — primary parity oracle
# https://spark.apache.org/docs/latest/api/sql/index.html#xxhash64
# -----------------------------------------------------------------------------

query I
SELECT spark_xxhash64('Spark', [123]::INTEGER[], 2::INTEGER);
----
5602566077635097486

# -----------------------------------------------------------------------------
# Per-type goldens
# -----------------------------------------------------------------------------

query I
SELECT spark_xxhash64(TRUE);
----
-6698625589789238999

query I
SELECT spark_xxhash64(FALSE);
----
3614696996920510707

# bool true folds as int32 1 — same as INTEGER 1 / TINYINT 1 / SMALLINT 1
query II
SELECT spark_xxhash64(TRUE) = spark_xxhash64(1::INTEGER),
       spark_xxhash64(1::INTEGER) = spark_xxhash64(1::TINYINT);
----
true	true

# bool false folds as int32 0 — same as INTEGER 0 / FLOAT 0.0 (raw bits 0) /
# DATE 1970-01-01 (days=0)
query III
SELECT spark_xxhash64(FALSE) = spark_xxhash64(0::INTEGER),
       spark_xxhash64(0::INTEGER) = spark_xxhash64(0.0::FLOAT),
       spark_xxhash64(0::INTEGER) = spark_xxhash64(DATE '1970-01-01');
----
true	true	true

query I
SELECT spark_xxhash64(0::INTEGER);
----
3614696996920510707

query I
SELECT spark_xxhash64(1::INTEGER);
----
-6698625589789238999

query I
SELECT spark_xxhash64((-1)::INTEGER);
----
2017008487422258757

# Sign-extension: SMALLINT -1 == INTEGER -1
query I
SELECT spark_xxhash64((-1)::SMALLINT) = spark_xxhash64((-1)::INTEGER);
----
true

query I
SELECT spark_xxhash64(1::BIGINT);
----
-7001672635703045582

query I
SELECT spark_xxhash64((-1)::BIGINT);
----
3858142552250413010

# NaN canonicalization: any NaN -> 0x7FC00000 (FLOAT) / 0x7FF8000000000000 (DOUBLE)
query I
SELECT spark_xxhash64('nan'::FLOAT);
----
2692338816207849720

query I
SELECT spark_xxhash64('nan'::DOUBLE);
----
-3127944061524951246

query I
SELECT spark_xxhash64(1.5::DOUBLE);
----
7738255526519901366

# Strings: empty + boundary lengths (32 / 33 cross the XXH64 stripe loop)
query I
SELECT spark_xxhash64('');
----
-7444071767201028348

query I
SELECT spark_xxhash64('a');
----
-8582455328737087284

query I
SELECT spark_xxhash64('hello');
----
-4367754540140381902

query I
SELECT spark_xxhash64('abcdefghijklmnopqrstuvwxyz012345');
----
221923967055193886

query I
SELECT spark_xxhash64('abcdefghijklmnopqrstuvwxyz0123456');
----
1134088583240772182

# Timestamp epoch (micros = 0) — same fold as BIGINT 0
query I
SELECT spark_xxhash64(TIMESTAMP '1970-01-01 00:00:00') = spark_xxhash64(0::BIGINT);
----
true

query I
SELECT spark_xxhash64(TIMESTAMP '1970-01-01 00:00:00');
----
-5252525462095825812

# Decimal: precision <= 18 (long path) vs precision > 18 (BigInteger bytes path)
query I
SELECT spark_xxhash64(123.45::DECIMAL(5,2));
----
8791244235932249694

query I
SELECT spark_xxhash64(123456789012345.6789::DECIMAL(38,4));
----
6291565527293009989

# -----------------------------------------------------------------------------
# Nested types
# -----------------------------------------------------------------------------

# Spark invariant: array(1, 2) folds the same as columns (1, 2).
query I
SELECT spark_xxhash64([1, 2]::INTEGER[]) = spark_xxhash64(1::INTEGER, 2::INTEGER);
----
true

query I
SELECT spark_xxhash64([1, 2, 3]::INTEGER[]);
----
8592097078962733837

# NULL list elements are skipped: [1, NULL, 2] == [1, 2]
query I
SELECT spark_xxhash64([1, NULL, 2]::INTEGER[]) = spark_xxhash64([1, 2]::INTEGER[]);
----
true

# Empty list and NULL list both contribute nothing
query I
SELECT spark_xxhash64([]::INTEGER[]);
----
42

query I
SELECT spark_xxhash64(NULL::INTEGER[]);
----
42

# STRUCT: field names not hashed, only values; null fields skipped
query I
SELECT spark_xxhash64({'a': 1::INTEGER, 'b': 'hello'});
----
-2644647410986480234

# MAP
query I
SELECT spark_xxhash64(MAP {1::INTEGER: 'a', 2::INTEGER: 'b'});
----
8744364272684979380

# -----------------------------------------------------------------------------
# Multi-column seed chaining
# -----------------------------------------------------------------------------

query I
SELECT spark_xxhash64(1::INTEGER, 2::BIGINT, 'hello');
----
5198346398884226828

# -----------------------------------------------------------------------------
# Vectorized batch (per-row independence)
# -----------------------------------------------------------------------------

query II
SELECT i, spark_xxhash64(i::BIGINT) FROM range(3) t(i);
----
0	-5252525462095825812
1	-7001672635703045582
2	-3341702809300393011

# -----------------------------------------------------------------------------
# Unsupported types throw at bind time
# -----------------------------------------------------------------------------

statement error
SELECT spark_xxhash64(1::UTINYINT);
----
no Spark equivalent

statement error
SELECT spark_xxhash64(NULL::UBIGINT);
----
no Spark equivalent

statement error
SELECT spark_xxhash64(NULL::HUGEINT);
----
no Spark equivalent

statement error
SELECT spark_xxhash64(NULL::TIME);
----
no Spark equivalent

# Recursive check fires for unsupported types inside LIST
statement error
SELECT spark_xxhash64([1]::UTINYINT[]);
----
no Spark equivalent
