# name: test/sql/table_operations.test
# description: Tests with table data and vector processing
# group: [sql]

require thdck_spark_funcs

# DECIMAL(10,2)/DECIMAL(10,2) returns DECIMAL(23,13), so table execution uses
# scale_adj=13 for every row.
statement ok
CREATE TABLE decimals (
    id INTEGER,
    a DECIMAL(10,2),
    b DECIMAL(10,2)
);


statement ok
INSERT INTO decimals VALUES
    (1, 10.00, 3.00),
    (2, 100.00, 4.00),
    (3, 7.00, 2.00),
    (4, -10.00, 3.00),
    (5, 1.00, 7.00);

query II
SELECT id, spark_decimal_div(a, b) FROM decimals ORDER BY id;
----
1	3.3333333333333
2	25.0000000000000
3	3.5000000000000
4	-3.3333333333333
5	0.1428571428571

query I
SELECT typeof(spark_decimal_div(a, b)) FROM decimals LIMIT 1;
----
DECIMAL(23,13)

statement ok
CREATE TABLE decimals_with_nulls (
    id INTEGER,
    a DECIMAL(10,2),
    b DECIMAL(10,2)
);

statement ok
INSERT INTO decimals_with_nulls VALUES
    (1, 10.00, 3.00),
    (2, NULL, 5.00),
    (3, 20.00, NULL),
    (4, NULL, NULL),
    (5, 15.00, 0.00),
    (6, 30.00, 6.00);

# NULL operands and zero divisors produce NULL without changing valid rows.
query II
SELECT id, spark_decimal_div(a, b) FROM decimals_with_nulls ORDER BY id;
----
1	3.3333333333333
2	NULL
3	NULL
4	NULL
5	NULL
6	5.0000000000000

statement ok
CREATE TABLE mixed_values (
    id INTEGER,
    a DECIMAL(8,2),
    b DECIMAL(8,2)
);


statement ok
INSERT INTO mixed_values VALUES
    (1, 100.00, 3.00),
    (2, -100.00, 3.00),
    (3, 100.00, -3.00),
    (4, -100.00, -3.00),
    (5, 0.00, 5.00),
    (6, 50.00, 0.00),
    (7, NULL, 10.00),
    (8, 10.00, NULL),
    (9, 1.00, 3.00),
    (10, 2.00, 3.00);

query II
SELECT id, spark_decimal_div(a, b) FROM mixed_values ORDER BY id;
----
1	33.33333333333
2	-33.33333333333
3	-33.33333333333
4	33.33333333333
5	0.00000000000
6	NULL
7	NULL
8	NULL
9	0.33333333333
10	0.66666666667

query I
SELECT COUNT(*) FROM mixed_values WHERE spark_decimal_div(a, b) IS NOT NULL;
----
7

query I
SELECT COUNT(*) FROM mixed_values WHERE spark_decimal_div(a, b) IS NULL;
----
3

statement ok
CREATE TABLE uniform_data (
    a DECIMAL(6,2),
    b DECIMAL(6,2)
);


statement ok
INSERT INTO uniform_data SELECT 10.00, 3.00 FROM range(100);

# Repeated input rows must produce one stable vectorized result.
query I
SELECT DISTINCT spark_decimal_div(a, b) FROM uniform_data;
----
3.333333333

query I
SELECT COUNT(DISTINCT spark_decimal_div(a, b)) FROM uniform_data;
----
1

query II
SELECT id, spark_decimal_div(a, b) FROM mixed_values
WHERE spark_decimal_div(a, b) IS NOT NULL AND spark_decimal_div(a, b) > 0
ORDER BY id;
----
1	33.33333333333
4	33.33333333333
9	0.33333333333
10	0.66666666667

statement ok
CREATE TABLE prices (
    item_id INTEGER,
    total DECIMAL(10,2),
    quantity DECIMAL(10,2)
);

statement ok
INSERT INTO prices VALUES
    (1, 100.00, 3.00),
    (2, 50.00, 7.00),
    (3, 200.00, 6.00);

query II
SELECT item_id, spark_decimal_div(total, quantity)
FROM prices
ORDER BY item_id;
----
1	33.3333333333333
2	7.1428571428571
3	33.3333333333333

query I
SELECT DISTINCT spark_decimal_div(total, total) FROM prices WHERE total != 0;
----
1.0000000000000

query I
SELECT spark_decimal_div(sub.s, 2.00::DECIMAL(10,2))
FROM (SELECT 10.00::DECIMAL(10,2) AS s) sub;
----
5.0000000000000
